{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client", "vitest/globals"]
  },
  "include": [
    "apps/host/scripts/altc4-host-entry.tsx",
    "apps/host/scripts/altc4-host-entry.test.tsx",
    "apps/player/main.tsx",
    "games/altc4/ui/**/*.tsx"
  ]
}
